                    id,idempotency_key,business_name,contact_name,work_email,state,county,
                    employee_count,estimated_annual_childcare_budget,company_website,
                    consent_recorded,status,created_at,expires_at
                ) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?)
                """,
                (
                    lead_id,idempotency_key,lead.business_name,lead.contact_name,str(lead.work_email),
                    lead.state,lead.county,lead.employee_count,lead.estimated_annual_childcare_budget,
                    lead.company_website,1,"PENDING_RADAH_HANDOFF",now,expires_at,
                ),
            )
        except Exception:
            existing = conn.execute(
                "SELECT id,status FROM childcare_leads WHERE idempotency_key=?",
                (idempotency_key,),
            ).fetchone()
            if existing:
                return {
                    "accepted": True,
                    "lead_id": existing["id"],
                    "status": existing["status"],
                    "idempotent_replay": True,
                    "external_handoff_executed": False,
                }
            raise

    append_audit(
        correlation_id=request.state.correlation_id,
        actor="public-childcare-tool",
        action="CAPTURE_CHILDCARE_LEAD",
        target=f"childcare-lead:{lead_id}",
        result="SUCCESS",
        after={
            "lead_id": lead_id,
            "state": lead.state,
            "county": lead.county,
            "status": "PENDING_RADAH_HANDOFF",
            "consent_recorded": True,
            "expires_at": expires_at,
        },
    )

    return {
        "accepted": True,
        "lead_id": lead_id,
        "status": "PENDING_RADAH_HANDOFF",
        "idempotent_replay": False,
        "external_handoff_executed": False,
        "note": "Lead is stored locally. External referral requires a separate RADAH-authorized executor.",
    }


@app.post("/v1/tools/employer-childcare/leads/{lead_id}/status", dependencies=[Depends(require_api_key)])
def set_employer_childcare_lead_status(
    lead_id: str,
    body: GovernedChildcareLeadStatus,
    x_radah_signature: str | None = Header(default=None),
    x_radah_timestamp: str | None = Header(default=None),
):
    target = f"childcare-lead:{lead_id}"
    enforce_radah(
        body.radah,
        expected_action="SET_CHILDCARE_LEAD_STATUS",
        expected_target=target,
        signature=x_radah_signature,
        signature_timestamp=x_radah_timestamp,
    )

    with tx(write=True) as conn:
        row = conn.execute("SELECT * FROM childcare_leads WHERE id=?", (lead_id,)).fetchone()
        if not row:
            raise HTTPException(status_code=404, detail="Lead not found")
        before = dict(row)
        conn.execute("UPDATE childcare_leads SET status=? WHERE id=?", (body.status, lead_id))
        after = dict(conn.execute("SELECT * FROM childcare_leads WHERE id=?", (lead_id,)).fetchone())

    append_audit(
        correlation_id=body.radah.correlation_id,
        actor="traffic-engine",
        action="SET_CHILDCARE_LEAD_STATUS",
        target=target,
        result="SUCCESS",
        before={"status": before["status"]},
        after={
            "status": after["status"],
            "provider": body.provider,
            "receipt_id": body.receipt_id,
        },
    )
    return {
        "lead_id": lead_id,
        "status": body.status,
        "provider": body.provider,
        "receipt_id": body.receipt_id,
    }


@app.get("/v1/tools/employer-childcare/leads", dependencies=[Depends(require_api_key)])
def list_employer_childcare_leads(status: str = "PENDING_RADAH_HANDOFF", limit: int = 100):
    allowed = {"PENDING_RADAH_HANDOFF", "REFERRED", "CLOSED"}
    if status not in allowed:
        raise HTTPException(status_code=422, detail="Invalid lead status")
    limit = max(1, min(limit, 250))
    now = int(time.time())
    with tx(write=True) as conn:
        conn.execute("DELETE FROM childcare_leads WHERE expires_at < ?", (now,))
        rows = conn.execute(
            """
            SELECT id,business_name,contact_name,work_email,state,county,employee_count,
                   estimated_annual_childcare_budget,company_website,consent_recorded,status,
                   created_at,expires_at
            FROM childcare_leads
            WHERE status=?
            ORDER BY created_at ASC
            LIMIT ?
            """,
            (status, limit),
        ).fetchall()
    return {"count": len(rows), "leads": [dict(row) for row in rows]}


@app.get("/v1/tools/employer-childcare/providers")
def employer_childcare_providers():
    return {"providers": [provider_public_descriptor()]}


@app.post(
    "/v1/tools/employer-childcare/leads/{lead_id}/handoff",
    dependencies=[Depends(require_api_key)],
)
def authorize_employer_childcare_handoff(
    lead_id: str,
    body: GovernedChildcareHandoff,
    request: Request,
    x_radah_signature: str | None = Header(default=None),
    x_radah_timestamp: str | None = Header(default=None),
):
    """
    Create a time-limited, privacy-safe handoff link after RADAH ALLOW.

    No stored lead PII is appended to the provider URL and no provider form is
    submitted server-side. This is deliberate because no public employer-
    referral submission API has been verified for the current provider.
    """
    target = f"childcare-lead:{lead_id}"
    enforce_radah(
        body.radah,
        expected_action="AUTHORIZE_CHILDCARE_HANDOFF",
        expected_target=target,
        signature=x_radah_signature,
        signature_timestamp=x_radah_timestamp,
    )

    if body.provider != "tootris":
        raise HTTPException(status_code=422, detail="Unsupported provider")
    if not provider_is_current():
        raise HTTPException(
            status_code=423,
            detail="Provider referral terms require re-verification before handoff.",
        )

    now = int(time.time())
    with tx() as conn:
        lead = conn.execute(
            "SELECT * FROM childcare_leads WHERE id=?",
            (lead_id,),
        ).fetchone()
    if not lead:
        raise HTTPException(status_code=404, detail="Lead not found")
    if not lead["consent_recorded"]:
        raise HTTPException(status_code=403, detail="Lead-sharing consent not recorded")
    if lead["expires_at"] <= now:
        raise HTTPException(status_code=410, detail="Lead expired")
    if lead["status"] in {"CLOSED", "PURGED"}:
        raise HTTPException(status_code=409, detail="Lead is not eligible for handoff")

    raw_token = secrets.token_urlsafe(32)
    token_hash = hashlib.sha256(raw_token.encode()).hexdigest()
