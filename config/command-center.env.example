# Copy to: ~/.config/dominion/command-center.env
# Then run: chmod 600 ~/.config/dominion/command-center.env
# Never commit the real values.

# Primary Dominion intelligence worker.
# Recovery hold: keep NEMOTRON_BASE_URL empty until a separately reviewed,
# Founder-authorized Nemotron activation has fresh runtime acceptance evidence.
NEMOTRON_BASE_URL=
NEMOTRON_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEMOTRON_API_KEY=

# Governed reasoning fallback.
# Conductor remains the execution/orchestration service on 127.0.0.1:5060.
# Buddy Web owns the supported authenticated reasoning contract on 127.0.0.1:5070.
# The deployment extracts only BUDDY_WEB_TOKEN from Buddy's existing local dotenv
# chain into a mode-600 Docker secret; the token is never committed here.
BUDDY_FALLBACK_URL=http://127.0.0.1:5070
INTELLIGENCE_TIMEOUT_SECONDS=60

# First revenue-ready offer: The Art of True Healing — $27
# CHECKOUT must be the verified live payment URL.
# DELIVERY must be the verified private delivery workflow or protected file target.
CHECKOUT_ART_OF_TRUE_HEALING=
DELIVERY_ART_OF_TRUE_HEALING=

# Keep later offers blocked until individually tested.
CHECKOUT_CREDIT_DISPUTE_TOOLKIT=
DELIVERY_CREDIT_DISPUTE_TOOLKIT=
CHECKOUT_AI_AUTOMATION_BLUEPRINT=
DELIVERY_AI_AUTOMATION_BLUEPRINT=

VAULT_PATH=/home/malachisingleton8/vault
COMMAND_CENTER_MEMORY_PATH=/home/malachisingleton8/dominion-memory
