# Dominion Council Node — environment template.
# Names only. Never commit real values; this file is the contract, not the store.
# On the VM these live in /etc/dominion/secrets with mode 0600, or Oracle Vault.

# ── service ────────────────────────────────────────────────────────────
COUNCIL_ENVIRONMENT=production
COUNCIL_BIND_HOST=127.0.0.1
COUNCIL_BIND_PORT=8200

# ── data plane ─────────────────────────────────────────────────────────
COUNCIL_DATABASE_URL=
COUNCIL_REDIS_URL=
COUNCIL_RECEIPT_DIR=/var/lib/dominion/receipts
COUNCIL_GOVERNANCE_DIR=/opt/dominion/council-node/governance

# ── local models ───────────────────────────────────────────────────────
COUNCIL_OLLAMA_URL=http://ollama:11434
COUNCIL_LOCAL_MODEL=qwen2.5:7b
COUNCIL_EMBEDDING_MODEL=nomic-embed-text

# ── external model adapters (optional, off by default) ─────────────────
# Leave EXTERNAL_MODELS_ENABLED unset to keep every prompt on this machine.
COUNCIL_EXTERNAL_MODELS_ENABLED=false
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Founder control ────────────────────────────────────────────────────
# Without this the Founder endpoints reject everything. That is intentional.
COUNCIL_FOUNDER_TOKEN=

# ── scheduler ──────────────────────────────────────────────────────────
COUNCIL_SWEEP_INTERVAL_HOURS=3
COUNCIL_LANE_STALE_HOURS=6

# ── postgres container ─────────────────────────────────────────────────
POSTGRES_USER=dominion
POSTGRES_PASSWORD=
POSTGRES_DB=council
