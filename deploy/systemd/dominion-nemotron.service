[Unit]
Description=Dominion Nemotron Primary Intelligence Worker
After=network-online.target ollama.service
Wants=network-online.target
Requires=ollama.service

[Service]
Type=simple
User=malachisingleton8
Group=malachisingleton8
WorkingDirectory=/home/malachisingleton8/.dominion/nemotron/runtime/release/apps/nemotron-worker
Environment=OLLAMA_BASE_URL=http://127.0.0.1:11434
Environment=NEMOTRON_MODEL=nemotron-3-nano:4b
Environment=NEMOTRON_LISTEN_HOST=127.0.0.1
Environment=NEMOTRON_LISTEN_PORT=11435
Environment=NEMOTRON_TIMEOUT_SECONDS=300
Environment=NEMOTRON_NUM_CTX=4096
Environment=NEMOTRON_MAX_CONCURRENCY=1
ExecStart=/usr/bin/python3 /home/malachisingleton8/.dominion/nemotron/runtime/release/apps/nemotron-worker/nemotron_worker.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
