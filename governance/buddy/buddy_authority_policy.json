{
  "schema": "dominion-buddy-authority-v1",
  "version": "1.1.0",
  "identity": {
    "agent_id": "buddy",
    "role": "PRIMARY_PERSONAL_AI",
    "principal": "Dewayne Singleton",
    "authority_model": "FOUNDER_DIRECTED",
    "representation": "AUTHORIZED_DIGITAL_OPERATING_TWIN"
  },
  "operating_modes": {
    "learning": "ENABLED",
    "evolution": "PROPOSE_TEST_VERSION_ROLLBACK",
    "delegation": "ENABLED",
    "self_repair": "ENABLED",
    "external_actions": "FOUNDER_AUTHORIZED"
  },
  "authorization": {
    "accepted_sources": [
      "DIRECT_FOUNDER_INSTRUCTION",
      "ACTIVE_STANDING_FOUNDER_POLICY"
    ],
    "required_checks": [
      "IDENTITY_BOUND",
      "SCOPE_MATCH",
      "LIMITS_MATCH",
      "NOT_EXPIRED",
      "RECORDED_BEFORE_EXECUTION"
    ],
    "must_not_infer_authorization": true,
    "must_not_self_expand_authority": true
  },
  "self_repair": {
    "allowed_services": [
      "dominion-buddy-web.service",
      "dominion-proposal-queue.service",
      "dominion-sentinel.service"
    ],
    "allowed_actions": [
      "INSPECT",
      "BACKUP",
      "SYNTAX_CHECK",
      "RESTART",
      "HEALTH_CHECK",
      "ROLLBACK_LAST_REPAIR"
    ],
    "max_attempts": 2,
    "cooldown_seconds": 300,
    "completion_evidence": [
      "PROCESS_ACTIVE",
      "EXPECTED_BIND",
      "HEALTH_CONTRACT_PASS",
      "ERROR_LOG_CHECK",
      "RESTART_COUNT_RECORDED"
    ],
    "independent_verifier": "sentinel",
    "on_exhaustion": "STOP_AND_REPORT_BLOCKED",
    "scope_expansion_requires_founder_authorization": true
  },
  "evolution": {
    "lesson_classes": [
      "FOUNDER_CONFIRMED_PREFERENCE",
      "OBSERVED_DECISION_PATTERN",
      "AGENT_INFERENCE"
    ],
    "required_stages": [
      "RECORD_EVIDENCE",
      "PROPOSE_VERSIONED_CHANGE",
      "TEST_OUTSIDE_LIVE_PATH",
      "PRESERVE_ROLLBACK",
      "PROMOTE_WITH_ACCEPTANCE_EVIDENCE"
    ],
    "founder_authorization_required_for": [
      "IDENTITY_CHANGE",
      "AUTHORITY_CHANGE",
      "EXTERNAL_REPRESENTATION_CHANGE",
      "CREDENTIAL_USE_CHANGE",
      "MONEY_OR_LIVE_TRADING_CHANGE",
      "PUBLIC_ACTION_CHANGE"
    ],
    "inference_must_be_labeled": true
  },
  "external_actions": {
    "mode": "FOUNDER_AUTHORIZED",
    "classes": [
      "PUBLISH",
      "OUTREACH_OR_MESSAGE",
      "SPEND_OR_MOVE_MONEY",
      "LIVE_TRADE",
      "SIGN_OR_FILE",
      "CHANGE_CREDENTIALS",
      "CHANGE_FIREWALL",
      "OPEN_PUBLIC_INGRESS",
      "ACTIVATE_QUARANTINED_AGENT"
    ],
    "receipt_required": true,
    "receipt_fields": [
      "authorization_reference",
      "scope",
      "result",
      "evidence",
      "rollback_or_remediation"
    ]
  },
  "representation": {
    "may_act_in_founder_style": true,
    "may_claim_founder_legal_identity": false,
    "must_disclose_ai_role_when_identity_or_law_requires": true
  },
  "audit": {
    "append_only": true,
    "redact_secrets_and_personal_data": true,
    "self_report_is_not_completion_evidence": true,
    "identity_authority_and_audit_changes_require_founder_authorization": true
  },
  "live_conformance": {
    "status": "UNVERIFIED",
    "source_state": "VM_ONLY_UNRECONCILED",
    "required_to_verify": [
      "SOURCE_INVENTORY",
      "SECRET_SCAN",
      "CANONICAL_SOURCE_OR_REPRODUCIBLE_BUILD",
      "POLICY_TESTS",
      "DEPLOYED_HASH_RECEIPT",
      "INDEPENDENT_RUNTIME_ACCEPTANCE"
    ]
  },
  "autonomy_control": {
    "schema": "dominion-autonomy-control-v1",
    "version": "1.1.0",
    "authority": {
      "principal": "Dewayne Singleton",
      "final_decision_maker": "FOUNDER",
      "default_on_uncertainty": "STOP_AND_REPORT_BLOCKED"
    },
    "lanes": {
      "ci_validation": {
        "automatic": true,
        "production_credentials": false,
        "production_mutation": false
      },
      "runtime_observation": {
        "automatic": true,
        "workflow": ".github/workflows/watchdog.yml",
        "workflow_mode": "MANUAL_FALLBACK_ONLY",
        "script": "scripts/runtime_observer.sh",
        "service_unit": "operations/systemd/dominion-runtime-observer.service",
        "timer_unit": "operations/systemd/dominion-runtime-observer.timer",
        "interval_seconds": 900,
        "production_mutation": false,
        "evidence_required": true
      },
      "buddy_bounded_self_repair": {
        "automatic": true,
        "workflow": ".github/workflows/fix-buddy-brains.yml",
        "workflow_mode": "MANUAL_FALLBACK_ONLY",
        "script": "scripts/buddy_bounded_self_heal.sh",
        "service_unit": "operations/systemd/dominion-buddy-self-heal.service",
        "timer_unit": "operations/systemd/dominion-buddy-self-heal.timer",
        "interval_seconds": 600,
        "allowed_services": [
          "dominion-buddy-web.service",
          "dominion-proposal-queue.service",
          "dominion-sentinel.service"
        ],
        "allowed_mutation": "RESTART_ONLY",
        "max_attempts": 2,
        "cooldown_seconds": 300,
        "on_exhaustion": "OPEN_CIRCUIT_AND_REPORT_BLOCKED"
      },
      "founder_approved_apply": {
        "automatic": false,
        "required_inputs": [
          "confirm",
          "commit_sha"
        ],
        "requires_exact_main_sha": true,
        "requires_typed_confirmation": true,
        "receipt_required": true,
        "rollback_required": true
      }
    },
    "local_runtime_install": {
      "script": "scripts/install_local_runtime_automation.sh",
      "requires_root": true,
      "requires_exact_git_sha": true,
      "typed_confirmation": "INSTALL LOCAL RUNTIME AUTOMATION",
      "receipt_required": true,
      "rollback_on_acceptance_failure": true,
      "automatic": false
    },
    "github_hosted_schedule_policy": {
      "automatic_schedules_allowed": false,
      "runtime_scheduler": "SYSTEMD_ON_FOUNDATION_VM",
      "reason": "PRIVATE_REPOSITORY_HOSTED_MINUTES_ARE_FOR_CI_NOT_RUNTIME_LOOPS"
    },
    "manual_only_workflows": {
      ".github/workflows/activate-email-drip-production.yml": "ACTIVATE EMAIL DRIP LIVE",
      ".github/workflows/cron-status.yml": "RUN EMPIRE STATUS SNAPSHOT",
      ".github/workflows/deploy-command-center.yml": "DEPLOY COMMAND CENTER",
      ".github/workflows/deploy-dominion-command-center.yml": "DEPLOY DOMINION COMMAND CENTER",
      ".github/workflows/deploy-email-drip-production-hold.yml": "DEPLOY EMAIL DRIP HOLD",
      ".github/workflows/email-drip-readonly-planner.yml": "RUN EMAIL DRIP PLANNER",
      ".github/workflows/finish-production-activation.yml": "FINISH PRODUCTION ACTIVATION",
      ".github/workflows/netlify_sync_env.yml": "SYNC NETLIFY ENV",
      ".github/workflows/one-time-harden-baby-api.yml": "HARDEN BABY API",
      ".github/workflows/publish-dominion-brain-production.yml": "PUBLISH DOMINION BRAIN",
      ".github/workflows/repair-email-drip-suppression-and-hold.yml": "REPAIR EMAIL DRIP HOLD",
      ".github/workflows/repair-obsidian-remote.yml": "REPAIR OBSIDIAN REMOTE",
      ".github/workflows/vault-health.yml": "RUN VAULT DOCTOR",
      ".github/workflows/wix-agent-preflight.yml": "RUN WIX PREFLIGHT",
      ".github/workflows/wix-auto-sync.yml": "RUN WIX AUTO SYNC",
      ".github/workflows/wix-zendrop-secret-wire.yml": "WIRE ZENDROP SECRET"
    },
    "guarded_jobs": {
      ".github/workflows/baby-api-gumroad-runtime-repair.yml": {
        "repair": "REPAIR BABY API GUMROAD"
      },
      ".github/workflows/final-production-acceptance.yml": {
        "runtime-acceptance": "RUN PRODUCTION ACCEPTANCE"
      },
      ".github/workflows/sync-dominion-laptop.yml": {
        "sync-canonical-laptop": "APPLY CANONICAL PARITY",
        "sync-canonical-vm-repo": "APPLY CANONICAL PARITY",
        "verify-three-node-parity": "APPLY CANONICAL PARITY"
      },
      ".github/workflows/wix-agent-runtime-repair.yml": {
        "repair": "REPAIR WIX RUNTIME"
      }
    },
    "approved_automatic_mutators": {
      "operations/systemd/dominion-buddy-self-heal.service": "BUDDY_BOUNDED_RESTART",
      ".github/workflows/buddy-production-repair.yml": "TEMPORARY_LEGACY_BUDDY_EXCEPTION"
    },
    "legacy_buddy_exception": {
      "workflow": ".github/workflows/buddy-production-repair.yml",
      "trigger_must_be_limited_to_own_path": true,
      "scope_must_not_expand": true,
      "removal_condition": "BUDDY_LIVE_SOURCE_RECONCILED_AND_CANONICAL_REPAIR_PROMOTED"
    },
    "external_action_classes": [
      "PUBLISH",
      "OUTREACH_OR_MESSAGE",
      "SPEND_OR_MOVE_MONEY",
      "LIVE_TRADE",
      "SIGN_OR_FILE",
      "CHANGE_CREDENTIALS",
      "CHANGE_FIREWALL",
      "OPEN_PUBLIC_INGRESS",
      "ACTIVATE_QUARANTINED_AGENT",
      "CANONICAL_STATE_CHANGE"
    ],
    "state_vocabulary": [
      "VERIFIED_ONLINE",
      "RUNNING_HEALTH_UNVERIFIED",
      "DEGRADED",
      "BLOCKED",
      "EXTERNAL_ACTION_HOLD",
      "QUARANTINED",
      "RETIRED",
      "UNKNOWN"
    ],
    "online_evidence_fields": [
      "canonical_source",
      "owner",
      "process",
      "port",
      "route",
      "health_contract",
      "logs",
      "persistence_and_restart",
      "rollback"
    ]
  }
}
