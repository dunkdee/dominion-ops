{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dominionhealing.org/schemas/commercial-release-1.0-closure-ledger.schema.json",
  "title": "Dominion Commercial Release 1.0 Closure Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "release_id",
    "release_objective",
    "generated_at",
    "evidence_ttl_hours",
    "allowed_progression",
    "components"
  ],
  "properties": {
    "release_id": {"const": "DOMINION-COMMERCIAL-RELEASE-1.0"},
    "release_objective": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "evidence_ttl_hours": {"type": "integer", "minimum": 1},
    "allowed_progression": {
      "const": [
        "BUILT",
        "TESTED",
        "DEPLOYED",
        "RUNTIME_VERIFIED",
        "END_TO_END_PROVEN",
        "COMMERCIAL_OPERATIONAL_CERTIFIED"
      ]
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/component"}
    }
  },
  "$defs": {
    "state": {
      "enum": [
        "UNKNOWN",
        "UNVERIFIED",
        "BUILT",
        "TESTED",
        "DEPLOYED",
        "VERIFIED",
        "PROVEN",
        "CERTIFIED",
        "BLOCKED",
        "STALE",
        "NOT_APPLICABLE",
        "RETIRED"
      ]
    },
    "evidenceReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_id", "kind", "reference", "verified_at"],
      "properties": {
        "receipt_id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "reference": {"type": "string", "minLength": 1},
        "verified_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "lane_id",
        "owner",
        "purpose",
        "location",
        "engineering_state",
        "deployment_state",
        "runtime_state",
        "customer_state",
        "commercial_state",
        "security_state",
        "recovery_state",
        "release_stage",
        "dependencies",
        "deployed_sha_or_digest",
        "last_verified_at",
        "evidence_receipts",
        "current_blocker",
        "rollback_reference"
      ],
      "properties": {
        "component_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
        "lane_id": {"type": "integer", "minimum": 1, "maximum": 12},
        "owner": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "location": {"type": "string", "minLength": 1},
        "engineering_state": {"$ref": "#/$defs/state"},
        "deployment_state": {"$ref": "#/$defs/state"},
        "runtime_state": {"$ref": "#/$defs/state"},
        "customer_state": {"$ref": "#/$defs/state"},
        "commercial_state": {"$ref": "#/$defs/state"},
        "security_state": {"$ref": "#/$defs/state"},
        "recovery_state": {"$ref": "#/$defs/state"},
        "release_stage": {
          "enum": [
            "UNKNOWN",
            "BUILT",
            "TESTED",
            "DEPLOYED",
            "RUNTIME_VERIFIED",
            "END_TO_END_PROVEN",
            "COMMERCIAL_OPERATIONAL_CERTIFIED",
            "BLOCKED",
            "STALE",
            "RETIRED"
          ]
        },
        "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "deployed_sha_or_digest": {"type": ["string", "null"]},
        "last_verified_at": {"type": ["string", "null"], "format": "date-time"},
        "evidence_receipts": {"type": "array", "items": {"$ref": "#/$defs/evidenceReceipt"}},
        "current_blocker": {"type": ["string", "null"]},
        "rollback_reference": {"type": ["string", "null"]}
      }
    }
  }
}
