{
  "version":"1.0.0",
  "default_behavior":"deny",
  "strategy":"monetize_governed_analysis_not_raw_identifiable_records",
  "allowed_products":[
    "aggregated_analytics",
    "market_benchmark_reports",
    "storefront_growth_audits",
    "client_owned_data_measurement",
    "monthly_optimization_reporting",
    "custom_read_only_analytics_builds"
  ],
  "prohibited_practices":[
    "sell_raw_personal_data",
    "sell_or_share_health_sensitive_data_for_ad_targeting",
    "reidentify_aggregated_records",
    "claim_estimated_data_is_first_party_truth",
    "guarantee_revenue_or_passive_income",
    "activate_external_campaign_without_human_approval",
    "use_data_outside_documented_purpose"
  ],
  "required_controls":[
    "documented_source_and_license",
    "purpose_limitation",
    "data_minimization",
    "retention_limit",
    "access_log",
    "evidence_classification",
    "legal_and_privacy_review_when_material",
    "human_approval_for_pricing_contact_and_publication"
  ],
  "evidence_classes":{
    "SYNTHETIC_TEST":"testing_only",
    "EXTERNAL_ESTIMATED":"market_signal_only",
    "FIRST_PARTY_VERIFIED":"operational_evidence",
    "PARTNER_GOVERNED":"contract_limited_collaboration"
  }
}
