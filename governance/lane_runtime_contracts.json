{
  "schema": "dominion-lane-runtime-contracts-v1",
  "version": "1.0.0",
  "governing_name": "RADAH MEMSHALAH — רָדָה מֶמְשָׁלָה",
  "purpose": "Make every registered lane an accountable production unit with explicit contracts, queues, health, evidence, dependencies, metrics, recovery, and escalation.",
  "runtime_state_root": "~/.dominion/control-plane",
  "required_lane_fields": [
    "principal_agent",
    "worker_id",
    "execution_binding",
    "dependencies",
    "implementation_paths",
    "input_contract",
    "output_contract",
    "work_queue",
    "failure_queue",
    "health_signals",
    "evidence_location",
    "metrics",
    "recovery_contract",
    "escalation_to"
  ],
  "lane_contracts": {
    "commerce_fulfillment": {
      "principal_agent": "revenue_operations",
      "worker_id": "commerce-operator",
      "execution_binding": "buddy_operator+dominion_revenue_runtime+wix_agent",
      "dependencies": ["infrastructure", "intelligence_orchestration", "governance_legal", "content_traffic"],
      "implementation_paths": ["apps/wix-agent/main.py", "apps/wix-agent/fulfillment.py", "revenue/verticals/wix_store.json"],
      "input_contract": ["storefront_state", "sku_economics", "funnel_evidence", "inventory_shipping_state", "authority_state"],
      "output_contract": ["diagnosis", "bounded_actions", "artifacts", "evidence_refs", "metrics", "blockers", "next_handoff"],
      "work_queue": "queues/commerce_fulfillment/pending",
      "failure_queue": "queues/commerce_fulfillment/failed",
      "health_signals": ["last_cycle_age", "last_status", "checkout_probe", "fulfillment_reconciliation", "funnel_evidence_age"],
      "evidence_location": "evidence/commerce_fulfillment",
      "metrics": ["qualified_visitors", "orders", "revenue_cents", "contribution_margin_cents", "refund_rate", "fulfillment_failure_rate"],
      "recovery_contract": ["record_failure", "preserve_order_idempotency", "rollback_reversible_change", "escalate_unresolved_external_effect"],
      "escalation_to": "coordinator"
    },
    "kdp_publishing": {
      "principal_agent": "revenue_operations",
      "worker_id": "publishing-operator",
      "execution_binding": "buddy_operator+kdp_packet_generator",
      "dependencies": ["infrastructure", "intelligence_orchestration", "governance_legal", "content_traffic"],
      "implementation_paths": ["revenue/verticals/kdp_publishing.json"],
      "input_contract": ["title_assets", "rights_evidence", "demand_evidence", "policy_clearances", "authority_state"],
      "output_contract": ["publish_packet", "merit_gate_results", "evidence_refs", "blockers", "next_handoff"],
      "work_queue": "queues/kdp_publishing/pending",
      "failure_queue": "queues/kdp_publishing/failed",
      "health_signals": ["last_cycle_age", "last_status", "packet_completeness", "merit_gate_state"],
      "evidence_location": "evidence/kdp_publishing",
      "metrics": ["titles_in_pipeline", "gates_passed", "gates_blocked", "verified_units", "verified_royalty_cents"],
      "recovery_contract": ["preserve_source_assets", "record_failed_gate", "rebuild_packet_from_evidence", "escalate_rights_or_policy_conflict"],
      "escalation_to": "coordinator"
    },
    "analytics_services": {
      "principal_agent": "revenue_operations",
      "worker_id": "revenue-operator",
      "execution_binding": "buddy_operator+analytics_audit",
      "dependencies": ["infrastructure", "intelligence_orchestration", "governance_legal", "services_lead_generation"],
      "implementation_paths": ["control_plane/analytics_audit.py", "revenue_products/storefront_growth_intelligence.json", "revenue/verticals/analytics_services.json"],
      "input_contract": ["buyer_problem_evidence", "permitted_dataset", "scope_constraints", "authority_state"],
      "output_contract": ["sample_audit", "service_package", "measurement_plan", "proposal_draft", "evidence_refs", "next_handoff"],
      "work_queue": "queues/analytics_services/pending",
      "failure_queue": "queues/analytics_services/failed",
      "health_signals": ["last_cycle_age", "last_status", "sample_audit_state", "evidence_freshness"],
      "evidence_location": "evidence/analytics_services",
      "metrics": ["qualified_opportunities", "sample_audits_ready", "paid_pilots", "delivery_cycle_minutes", "revenue_cents", "gross_margin_cents"],
      "recovery_contract": ["quarantine_bad_input", "preserve_source_lineage", "rerun_deterministic_analysis", "escalate_privacy_or_scope_conflict"],
      "escalation_to": "coordinator"
    },
    "digital_products": {
      "principal_agent": "revenue_operations",
      "worker_id": "revenue-operator",
      "execution_binding": "buddy_operator+digital_delivery_runtime",
      "dependencies": ["infrastructure", "content_traffic", "intelligence_orchestration"],
      "implementation_paths": ["scripts/gen_blueprint.py", "web/public/index.html"],
      "input_contract": ["buyer_problem_evidence", "offer_inventory", "checkout_state", "delivery_state", "authority_state"],
      "output_contract": ["product_asset", "offer_package", "landing_page_draft", "delivery_requirements", "validation_plan", "evidence_refs", "next_handoff"],
      "work_queue": "queues/digital_products/pending",
      "failure_queue": "queues/digital_products/failed",
      "health_signals": ["last_cycle_age", "last_status", "checkout_state", "delivery_state", "attribution_state"],
      "evidence_location": "evidence/digital_products",
      "metrics": ["qualified_visitors", "checkout_starts", "purchases", "delivered_orders", "revenue_cents", "contribution_margin_cents", "refund_rate"],
      "recovery_contract": ["preserve_customer_delivery_state", "retry_idempotent_delivery", "record_payment_delivery_mismatch", "escalate_money_or_customer_effect"],
      "escalation_to": "coordinator"
    },
    "services_lead_generation": {
      "principal_agent": "revenue_operations",
      "worker_id": "services-operator",
      "execution_binding": "buddy_operator+browser_agents",
      "dependencies": ["infrastructure", "intelligence_orchestration", "analytics_services"],
      "implementation_paths": ["apps/browser-agents/main.py"],
      "input_contract": ["service_inventory", "buyer_problem_definition", "qualification_rules", "public_opportunity_sources", "authority_state"],
      "output_contract": ["ranked_leads", "qualification_evidence", "proposal_drafts", "blockers", "next_handoff"],
      "work_queue": "queues/services_lead_generation/pending",
      "failure_queue": "queues/services_lead_generation/failed",
      "health_signals": ["last_cycle_age", "last_status", "qualified_lead_count", "source_freshness"],
      "evidence_location": "evidence/services_lead_generation",
      "metrics": ["qualified_leads", "approved_contacts", "responses", "proposals", "wins", "revenue_cents"],
      "recovery_contract": ["drop_stale_lead", "preserve_source_evidence", "requalify_before_contact", "escalate_external_contact"],
      "escalation_to": "coordinator"
    },
    "content_traffic": {
      "principal_agent": "revenue_operations",
      "worker_id": "content-operator",
      "execution_binding": "buddy_operator+traffic_scheduler",
      "dependencies": ["infrastructure", "intelligence_orchestration"],
      "implementation_paths": ["apps/youtube/pipeline.py", "apps/tiktok/main.py"],
      "input_contract": ["destination_offer", "buyer_intent_evidence", "channel_state", "claims_constraints", "attribution_contract"],
      "output_contract": ["content_package", "cta_map", "attribution_tags", "review_queue_item", "traffic_evidence", "next_handoff"],
      "work_queue": "queues/content_traffic/pending",
      "failure_queue": "queues/content_traffic/failed",
      "health_signals": ["last_cycle_age", "last_status", "destination_offer_state", "attribution_state", "channel_authorization_state"],
      "evidence_location": "evidence/content_traffic",
      "metrics": ["qualified_reach", "clicks", "qualified_sessions", "email_captures", "attributed_purchases", "attributed_revenue_cents"],
      "recovery_contract": ["hold_unapproved_asset", "repair_attribution_before_publish", "retire_bad_route", "escalate_publication_or_claim_risk"],
      "escalation_to": "coordinator"
    },
    "surplus": {
      "principal_agent": "research",
      "worker_id": "surplus-operator",
      "execution_binding": "buddy_operator+surplus_research",
      "dependencies": ["infrastructure", "intelligence_orchestration", "governance_legal"],
      "implementation_paths": ["apps/site-fixes/surplus.html", ".github/workflows/check-surplus-service.yml"],
      "input_contract": ["jurisdiction", "public_source", "eligibility_rules", "legal_boundary", "authority_state"],
      "output_contract": ["opportunity_packet", "eligibility_evidence", "process_map", "risk_flags", "blockers", "next_handoff"],
      "work_queue": "queues/surplus/pending",
      "failure_queue": "queues/surplus/failed",
      "health_signals": ["last_cycle_age", "last_status", "source_freshness", "jurisdiction_workflow_state"],
      "evidence_location": "evidence/surplus",
      "metrics": ["opportunities_screened", "qualified_opportunities", "estimated_recoverable_value_cents", "legal_holds", "approved_cases", "verified_revenue_cents"],
      "recovery_contract": ["discard_unverifiable_record", "preserve_public_source", "stop_on_jurisdiction_conflict", "escalate_contact_or_filing"],
      "escalation_to": "coordinator"
    },
    "trading": {
      "principal_agent": "research",
      "worker_id": "alpha-governor",
      "execution_binding": "alpha_engine+paper_broker",
      "dependencies": ["infrastructure", "intelligence_orchestration", "governance_legal"],
      "implementation_paths": ["alpha_engine/dominion_alpha/governor.py", "alpha_engine/dominion_alpha/risk.py", "alpha_engine/dominion_alpha/paper_broker.py"],
      "input_contract": ["market_data", "strategy_version", "risk_policy", "paper_account_state"],
      "output_contract": ["paper_orders", "performance_packet", "risk_metrics", "failure_modes", "next_test"],
      "work_queue": "queues/trading/pending",
      "failure_queue": "queues/trading/failed",
      "health_signals": ["last_cycle_age", "last_status", "market_data_freshness", "paper_broker_state", "risk_guard_state"],
      "evidence_location": "evidence/trading",
      "metrics": ["sample_size", "profit_factor", "max_drawdown", "expectancy", "win_rate", "paper_pnl_cents"],
      "recovery_contract": ["stop_paper_execution", "preserve_trade_ledger", "reset_strategy_state_from_checkpoint", "escalate_risk_violation"],
      "escalation_to": "coordinator"
    },
    "intelligence_orchestration": {
      "principal_agent": "conductor",
      "worker_id": "jarvis-governor",
      "execution_binding": "conductor+buddy_operator",
      "dependencies": ["infrastructure", "governance_legal"],
      "implementation_paths": ["apps/jarvis/worker.py", "api/app.py"],
      "input_contract": ["work_packet", "lane_registry", "runtime_state", "dependency_state", "authority_state"],
      "output_contract": ["route_decision", "dispatch_receipt", "dependency_handoff", "failure_escalation", "audit_event"],
      "work_queue": "queues/intelligence_orchestration/pending",
      "failure_queue": "queues/intelligence_orchestration/failed",
      "health_signals": ["queue_age", "dispatch_latency", "orphan_packet_count", "duplicate_dispatch_count", "dependency_block_count"],
      "evidence_location": "evidence/intelligence_orchestration",
      "metrics": ["packets_routed", "successful_handoffs", "held_handoffs", "orphan_packets", "mean_dispatch_seconds"],
      "recovery_contract": ["deduplicate_packet", "requeue_idempotently", "quarantine_contract_violation", "escalate_unowned_work"],
      "escalation_to": "coordinator"
    },
    "governance_legal": {
      "principal_agent": "governor",
      "worker_id": "five-council",
      "execution_binding": "governor+five_council+juris",
      "dependencies": ["infrastructure"],
      "implementation_paths": ["governance/verticals.json", "governance/DOMINION_REVENUE_MANIFESTO.md", "governance/authority_matrix.json"],
      "input_contract": ["proposed_action", "risk_level", "evidence_refs", "requested_authority", "data_classification"],
      "output_contract": ["policy_decision", "required_reviews", "hold_or_veto", "human_gate", "audit_event"],
      "work_queue": "queues/governance_legal/pending",
      "failure_queue": "queues/governance_legal/failed",
      "health_signals": ["unreviewed_high_risk_count", "policy_conflict_count", "missing_evidence_count", "stale_hold_count"],
      "evidence_location": "evidence/governance_legal",
      "metrics": ["reviews", "holds", "vetoes", "policy_conflicts", "approval_cycle_minutes"],
      "recovery_contract": ["fail_closed", "preserve_dissent", "require_new_evidence", "escalate_to_human_overseer"],
      "escalation_to": "human_overseer"
    },
    "infrastructure": {
      "principal_agent": "engineering",
      "worker_id": "platform-operator",
      "execution_binding": "systemd+docker+caddy+github_actions",
      "dependencies": [],
      "implementation_paths": ["docker-compose.yml", "STATE.md", "ops/RUNBOOK.md"],
      "input_contract": ["desired_release", "runtime_inventory", "health_contract", "backup_state", "authority_state"],
      "output_contract": ["deployment_receipt", "health_receipt", "backup_receipt", "rollback_receipt", "runtime_inventory"],
      "work_queue": "queues/infrastructure/pending",
      "failure_queue": "queues/infrastructure/failed",
      "health_signals": ["service_health", "timer_health", "container_health", "disk_state", "backup_age", "route_health", "config_drift"],
      "evidence_location": "evidence/infrastructure",
      "metrics": ["healthy_services", "degraded_services", "failed_deployments", "rollback_success_rate", "backup_age_seconds", "mean_recovery_seconds"],
      "recovery_contract": ["rollback_exact_release", "restore_last_good_config", "preserve_persistent_data", "escalate_secret_or_dns_change"],
      "escalation_to": "coordinator"
    }
  }
}
