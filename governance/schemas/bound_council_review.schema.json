{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dominion Bound Council Review Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["council_id", "reviewer_agent_id", "decision", "evidence", "rationale", "conditions"],
  "properties": {
    "council_id": {"enum": ["truth_evidence", "law_governance", "security_risk", "engineering_reliability", "business_human_impact"]},
    "reviewer_agent_id": {"type": "string", "minLength": 1},
    "decision": {"enum": ["APPROVE", "APPROVE_WITH_CONDITIONS", "VETO", "HOLD", "ABSTAIN"]},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "rationale": {"type": "string", "minLength": 1},
    "conditions": {"type": "array", "items": {"type": "string"}}
  }
}
