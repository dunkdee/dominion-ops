{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dominion.local/schemas/founder_mission_record.schema.json",
  "title": "Dominion Founder Mission Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "mission_id", "title", "objective", "status", "truth_state",
    "initiating_event", "verified_facts", "unknowns_and_assumptions", "lane_assignments",
    "risk_level", "required_approvals", "verification_gate", "stop_conditions",
    "rollback_conditions", "memory_destination", "evidence_references", "policy_version"
  ],
  "properties": {
    "schema_version": {"const": "dominion-founder-mission-record-v1"},
    "mission_id": {"type": "string", "pattern": "^DOM-[A-Z0-9-]+$"},
    "title": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "status": {"enum": ["PLANNED", "GOVERNED", "BLOCKED", "VERIFIED_CLOSED"]},
    "truth_state": {"enum": ["VERIFIED", "INFERRED", "UNKNOWN", "BLOCKED"]},
    "initiating_event": {"type": "string", "minLength": 1},
    "verified_facts": {"type": "array", "items": {"type": "string"}},
    "unknowns_and_assumptions": {"type": "array", "items": {"type": "string"}},
    "lane_assignments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lane", "owner", "scope", "state", "conflict_check"],
        "properties": {
          "lane": {"enum": ["intelligence", "context_memory", "execution", "verification", "impact_revenue"]},
          "owner": {"type": "string", "minLength": 1},
          "scope": {"type": "string", "minLength": 1},
          "state": {"enum": ["governed_reasoning_only", "governed_memory_only", "dormant_by_default", "read_only", "draft_only"]},
          "conflict_check": {"type": "string", "minLength": 1}
        }
      }
    },
    "risk_level": {"enum": ["low", "moderate", "high", "critical", "prohibited"]},
    "required_approvals": {"type": "array", "items": {"type": "string"}},
    "verification_gate": {"type": "string", "minLength": 1},
    "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "rollback_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "memory_destination": {"type": "string", "minLength": 1},
    "evidence_references": {"type": "array", "items": {"type": "string"}},
    "policy_version": {"type": "string", "minLength": 1}
  }
}
