{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dominion.local/schemas/incident_record.schema.json",
  "title": "Dominion Incident Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "incident_id",
    "type",
    "severity",
    "status",
    "detected_at",
    "summary",
    "systems",
    "evidence",
    "containment",
    "root_cause",
    "corrective_actions",
    "preventive_actions",
    "owner",
    "regression_tests",
    "verification",
    "recurrence_monitor",
    "unresolved_risks"
  ],
  "properties": {
    "incident_id": {"type": "string", "minLength": 1},
    "type": {"enum": ["mistake", "failure", "near_miss", "policy_violation", "knowledge_defect", "reasoning_defect", "security_event"]},
    "severity": {"enum": ["SEV0", "SEV1", "SEV2", "SEV3", "SEV4"]},
    "status": {"enum": ["DETECTED", "CONTAINED", "EVIDENCE_PRESERVED", "ROOT_CAUSE_IDENTIFIED", "CORRECTIVE_ACTION_APPROVED", "CONTROL_IMPLEMENTED", "REGRESSION_PASSED", "MONITORING_ACTIVE", "CLOSED"]},
    "detected_at": {"type": "string", "format": "date-time"},
    "summary": {"type": "string", "minLength": 1},
    "systems": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "containment": {"type": "array", "items": {"type": "string"}},
    "root_cause": {"type": ["string", "null"]},
    "corrective_actions": {"type": "array", "items": {"type": "string"}},
    "preventive_actions": {"type": "array", "items": {"type": "string"}},
    "owner": {"type": "string", "minLength": 1},
    "regression_tests": {"type": "array", "items": {"type": "string"}},
    "verification": {"type": "array", "items": {"type": "string"}},
    "recurrence_monitor": {"type": ["string", "null"]},
    "unresolved_risks": {"type": "array", "items": {"type": "string"}}
  }
}
