{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dominion Proposal Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["proposal_id", "proposer_id", "objective", "requested_action", "risk", "evidence", "assumptions", "unknowns", "rollback_plan", "success_criteria", "external_effects"],
  "properties": {
    "proposal_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{2,95}$"},
    "proposer_id": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "requested_action": {"type": "string", "minLength": 1},
    "risk": {"enum": ["low", "moderate", "high", "critical"]},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "rollback_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "procedure"],
      "properties": {
        "trigger": {"type": "string", "minLength": 1},
        "procedure": {"type": "string", "minLength": 1}
      }
    },
    "success_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "external_effects": {"const": false}
  }
}
