{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dominion Tool Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "default_behavior", "tools"],
  "properties": {
    "version": {"type": "string", "minLength": 1},
    "default_behavior": {"const": "deny"},
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "purpose", "external_effect", "allowed_modes", "data_classifications"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{2,63}$"},
          "purpose": {"type": "string", "minLength": 1},
          "external_effect": {"enum": ["none", "read_only"]},
          "allowed_modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["SIMULATION", "SHADOW"]}},
          "data_classifications": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"]}}
        }
      }
    }
  }
}
