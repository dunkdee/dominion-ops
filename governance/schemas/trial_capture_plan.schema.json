{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dominion.local/schemas/trial_capture_plan.schema.json",
  "title": "Dominion Seven-Day Trial Capture Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["plan_id", "provider", "trial_window_days", "activation_status", "human_target_review_completed", "acquisition_methods", "targets", "daily_schedule", "storage", "billing_control", "quality_gates", "credit_control"],
  "properties": {
    "plan_id": {"type": "string", "minLength": 3},
    "provider": {"const": "SIMILARWEB"},
    "trial_window_days": {"const": 7},
    "activation_status": {"const": "NOT_STARTED"},
    "human_target_review_completed": {"type": "boolean"},
    "acquisition_methods": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["LOCAL_EXPORT", "MANUAL_RECORDED", "SIMILARWEB_DATA_EXPORTER", "SIMILARWEB_API_ENTITLED"]}},
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domain", "vertical_id", "priority", "purpose", "countries", "metrics"],
        "properties": {
          "domain": {"type": "string", "minLength": 4},
          "vertical_id": {"type": "string", "minLength": 1},
          "priority": {"type": "integer", "minimum": 1},
          "purpose": {"enum": ["OWNED_BASELINE", "DIRECT_BENCHMARK", "CATEGORY_LEADER", "SERVICE_PRODUCT_BENCHMARK"]},
          "countries": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2, "maxLength": 3}},
          "metrics": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "daily_schedule": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["day", "tasks"],
        "properties": {
          "day": {"type": "integer", "minimum": 0, "maximum": 7},
          "tasks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_export_path", "normalized_path", "manifest_path", "evidence_ledger_path"],
      "properties": {
        "raw_export_path": {"type": "string", "minLength": 1},
        "normalized_path": {"type": "string", "minLength": 1},
        "manifest_path": {"type": "string", "minLength": 1},
        "evidence_ledger_path": {"type": "string", "minLength": 1}
      }
    },
    "billing_control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["auto_billing_acknowledged", "cancellation_checkpoint_day", "owner", "automatic_cancellation"],
      "properties": {
        "auto_billing_acknowledged": {"const": true},
        "cancellation_checkpoint_day": {"enum": [5, 6]},
        "owner": {"const": "human_overseer"},
        "automatic_cancellation": {"const": false}
      }
    },
    "quality_gates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "credit_control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discover_capabilities_before_paid_queries", "api_entitlement_required", "reserve_percent", "max_requests_per_second"],
      "properties": {
        "discover_capabilities_before_paid_queries": {"const": true},
        "api_entitlement_required": {"const": true},
        "reserve_percent": {"type": "integer", "minimum": 0, "maximum": 50},
        "max_requests_per_second": {"type": "integer", "minimum": 1, "maximum": 10}
      }
    }
  }
}
