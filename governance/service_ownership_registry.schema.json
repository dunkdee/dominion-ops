{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dominionhealing.org/schemas/service-ownership-registry.schema.json",
  "title": "Dominion Service Ownership Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "source_of_truth", "services"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "source_of_truth": {"enum": ["production-vm-audit", "github-declared", "reconciled"]},
    "services": {
      "type": "array",
      "items": {"$ref": "#/$defs/service"}
    }
  },
  "$defs": {
    "truth_state": {"enum": ["VERIFIED", "INFERRED", "UNKNOWN", "BLOCKED"]},
    "lifecycle_state": {
      "enum": [
        "REGISTERED",
        "SPEC_REVIEW",
        "SIMULATION",
        "SHADOW",
        "CANARY",
        "LIMITED_PRODUCTION",
        "PRODUCTION",
        "SUSPENDED",
        "RETIRED"
      ]
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service_id",
        "display_name",
        "runtime_kind",
        "runtime_location",
        "owner_agent_id",
        "owner_role",
        "lifecycle_state",
        "truth_state",
        "obsidian_home",
        "dependencies",
        "evidence"
      ],
      "properties": {
        "service_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "display_name": {"type": "string", "minLength": 1},
        "runtime_kind": {"enum": ["docker", "systemd", "cron", "process", "workflow", "library", "external"]},
        "runtime_location": {"type": "string", "minLength": 1},
        "repository_path": {"type": ["string", "null"]},
        "owner_agent_id": {"type": ["string", "null"]},
        "owner_role": {"type": "string", "minLength": 1},
        "vertical_id": {"type": ["string", "null"]},
        "lifecycle_state": {"$ref": "#/$defs/lifecycle_state"},
        "truth_state": {"$ref": "#/$defs/truth_state"},
        "obsidian_home": {"type": "string", "minLength": 1},
        "port": {"type": ["integer", "null"], "minimum": 1, "maximum": 65535},
        "scheduler": {"type": ["string", "null"]},
        "dependencies": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "uniqueItems": true
        },
        "health_signal": {"type": ["string", "null"]},
        "rollback_reference": {"type": ["string", "null"]},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "captured_at", "truth_state"],
            "properties": {
              "source": {"type": "string", "minLength": 1},
              "captured_at": {"type": "string", "format": "date-time"},
              "truth_state": {"$ref": "#/$defs/truth_state"},
              "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
              "notes": {"type": ["string", "null"]}
            }
          }
        }
      }
    }
  }
}
